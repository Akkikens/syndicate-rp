# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Generate passwords with:  openssl rand -hex 24
# Use hex/alphanumeric only: oxmysql's connection-string parser breaks on
# ";" "=" "@" ":" "/" "?" "#" in passwords.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# Optional
TZ=America/New_York
